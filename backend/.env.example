# Puerto del backend
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Base de datos SQL Server
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_SERVER=tu_servidor
DB_NAME=tu_base
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Email SMTP (opcional)
